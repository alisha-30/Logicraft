# LogiCraft Environment Configuration Example
# Copy this file to .env for local overrides

DEBUG=True
SECRET_KEY=django-insecure-logicraft-student-key-replace-in-production-20261010
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Default: SQLite3 file)
DATABASE_NAME=db.sqlite3

# Random Seed for Synthetic Data Generation
DATA_RANDOM_SEED=42
